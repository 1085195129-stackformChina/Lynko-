<?xml version="1.0" encoding="utf-8"?>
<!-- Lynko launcher foreground: a desktop display (amber bezel + stand) with the
     phone mirrored inside its screen (near-white).

     108dp adaptive canvas. Geometry stays inside 26..82 x / 28..80 y, which is
     well within the central 72dp safe zone (18..90). Flat fills only — no
     gradients, no shadows, no text. Fully symmetric about x=54, so the mark is
     identical when a launcher mirrors it in RTL.

     The bezel is a CLOSED rounded rect: the inner hole (30.5..77.5 x,
     32.5..62.5 y) shares the outer rect's full extent minus an even 4.5dp
     wall on every side, including the bottom. An open-bottom frame reads as a
     letter "n" instead of a monitor. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- display bezel: outer rounded rect minus inner rounded rect (evenOdd) -->
    <path
        android:fillColor="#FFB454"
        android:fillType="evenOdd"
        android:pathData="M33,28 H75 A7,7 0 0 1 82,35 V59 A7,7 0 0 1 75,66 H33 A7,7 0 0 1 26,59 V35 A7,7 0 0 1 33,28 Z
                          M33,32.5 H75 A3,3 0 0 1 78,35.5 V59.5 A3,3 0 0 1 75,62.5 H33 A3,3 0 0 1 30,59.5 V35.5 A3,3 0 0 1 33,32.5 Z" />

    <!-- mirrored phone inside the screen -->
    <path
        android:fillColor="#F2F4F8"
        android:pathData="M51,34.5 H57 A3.5,3.5 0 0 1 60.5,38 V57 A3.5,3.5 0 0 1 57,60.5 H51 A3.5,3.5 0 0 1 47.5,57 V38 A3.5,3.5 0 0 1 51,34.5 Z" />

    <!-- stand: stem (flush with the bezel's bottom wall) + flat base bar -->
    <path
        android:fillColor="#FFB454"
        android:pathData="M51.75,65.5 H56.25 V75 H51.75 Z" />
    <path
        android:fillColor="#FFB454"
        android:pathData="M42,75 H66 A2,2 0 0 1 68,77 A2,2 0 0 1 66,79 H42 A2,2 0 0 1 40,77 A2,2 0 0 1 42,75 Z" />
</vector>